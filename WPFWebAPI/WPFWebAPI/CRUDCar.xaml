<Page x:Class="WPFWebAPI.CRUDCar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFWebAPI"
        mc:Ignorable="d"
      Background="White"
        Title="CRUDCar" Height="450" Width="800">
    
    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Данные автомобиля" FontSize="18" Margin="10"/>

            <StackPanel>

                <TextBlock Text="Марка"/>
                <TextBox Text="{Binding Brand}" Margin="5"/>
                
                <TextBlock Text="Модель"/>
                <TextBox Text="{Binding Model}" Margin="5"/>
                
                <TextBlock Text="Год"/>
                <TextBox Text="{Binding ReleaseYear}" Margin="5"/> 
                
                <TextBlock Text="Цена"/>
                <TextBox Text="{Binding Price}" Margin="5"/>
                
                <TextBlock Text="В наличии"/>
                <CheckBox IsChecked="{Binding IsAvailable}" Margin="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">

                <Button Content="Отмена" Margin="10" Click="Cancel_Click"/>

                <Button Content="Сохранить" Margin="10" Click="Save_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
